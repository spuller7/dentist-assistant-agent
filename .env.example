# Copy this file to .env and fill in your keys.
# .env is gitignored. Never commit real keys.

# Required for model calls (LangChain ChatOpenAI).
OPENAI_API_KEY=sk-your-openai-key

# Optional. Defaults to gpt-4o-mini (cheap and good enough for this demo).
OPENAI_MODEL=gpt-4o-mini

# LangSmith tracing + evals (required to see runs in the LangSmith UI).
# Create an API key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=riverside-dental-agent
